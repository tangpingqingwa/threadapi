# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
THREADAPI_DATABASE=/app/data/threadapi.sqlite

# Optional first key when the keys table is empty. xk_live_... or xk_test_...
# THREADAPI_BOOTSTRAP_KEY=xk_live_replace_me

# Live X is off unless one of these is set. CI forces fixtures.
# THREADAPI_LIVE=1
# THREADAPI_ADAPTER=live
# THREADAPI_FIXTURE_ONLY=1
