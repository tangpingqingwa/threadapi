# Copy to .env locally. Never commit real secrets.

# Required in production.
# THREADAPI_DATABASE=./data/threadapi.sqlite

# Optional first key when the database is empty.
# THREADAPI_BOOTSTRAP_KEY=xk_test_dev

# Live X is off unless one of these is set. CI forces fixtures.
# THREADAPI_LIVE=1
# THREADAPI_ADAPTER=live
# THREADAPI_FIXTURE_ONLY=1
